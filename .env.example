# Everest ALT backend — environment
# Copy to .env and fill in. Everything has a safe default for local dev.

# HTTP
PORT=8787
HOST=127.0.0.1

# Secret used to sign session tokens AND encrypt stored xAI keys at rest.
# CHANGE THIS in production — a long random string.
SERVER_SECRET=dev-only-secret-change-me-in-production

# Where the JSON datastore lives (swap for a real DB later).
DATA_FILE=data.json

# xAI / Grok. Leave XAI_API_KEY blank to let each user connect their own key,
# or to run the deterministic mock (no key needed) for demos.
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_API_KEY=

# Business
GIFT_MARGIN=0.15
BUDGET_CYCLE_DAYS=30
